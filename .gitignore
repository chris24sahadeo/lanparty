# Ansible controller state kept IN-TREE on purpose -- see the header of ansible.cfg.
# These three are the isolation mechanism, not build noise.
.venv/
.collections/
.ansible-tmp/
*.retry

# GAME DATA IS NEVER COMMITTED. This repo is public; Quake III Arena's pak0.pk3 is
# retail data that id Software never licensed for redistribution. pak1..pak8 come from
# the freely-redistributable 1.32 point release, but they are blocked too -- one rule is
# easier to keep than two, and nothing here needs them in git.
*.pk3
baseq3/
baseq3.zip
.gamedata/

# Xonotic's data IS freely licensed, so this pair of rules is about SIZE, not law: the
# release archive is 1.18 GB and GitHub rejects anything over 100 MB. roles/xonotic_common
# downloads it into .gamedata/ (already blocked above); these two catch a copy left
# somewhere else in the tree.
xonotic-*.zip
Xonotic/

# Anything with a password in it.
secrets/
*.vault
vault-password
